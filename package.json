{
  "name": "ide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "vitest run --allowOnly=false",
    "typecheck": "tsc -p packages/core && tsc -p packages/ui && tsc -p e2e",
    "probe:sdk": "node --import tsx packages/core/scripts/sdk-probe.ts",
    "parity:agent": "node --import tsx packages/core/scripts/agent-parity.ts",
    "check": "node scripts/check-tests.mjs && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @ide/ui build && playwright test",
    "dev:core": "node --watch --import tsx packages/core/src/main.ts --project . --allow-origin http://localhost:5173",
    "core": "node --import tsx packages/core/src/main.ts",
    "dev": "pnpm run \"/^dev:/\"",
    "build:watch": "pnpm --filter @ide/ui exec vite build --watch",
    "desktop": "pnpm --filter @ide/desktop start",
    "desktop:dist": "pnpm --filter @ide/desktop dist",
    "dev:ui":"pnpm --filter @ide/ui exec vite",
    "start": "pnpm --filter @ide/ui build && node --import tsx packages/core/src/main.ts --project . --ui packages/ui/dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
